load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "starpls_ide",
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "@crates//:salsa": "salsa",
    },
    compile_data = [
        "src/ty/allocations.pyi",
        "src/ty/cc_internal.pyi",
        "src/ty/collections.pyi",
        "src/ty/generated_file.pyi",
        "src/ty/legacy_py_cc_link_params.pyi",
        "src/ty/legacy_python.pyi",
        "src/ty/primitives.pyi",
        "src/ty/starlark.pyi",
    ],
    deps = all_crate_deps() + [
        "//crates/starpls_bazel",
        "//crates/starpls_common",
        "//crates/starpls_hir",
        "//crates/starpls_syntax",
        "//crates/starpls_test_util",
    ],
)

rust_test(
    name = "starpls_ide_test",
    aliases = {
        "@crates//:salsa": "salsa",
    },
    compile_data = [
        "//crates/starpls:src/builtin/builtin.pb",
    ],
    crate = ":starpls_ide",
    deps = all_crate_deps(normal_dev = True),
    # BuildBuddy predictions overrode EstimatedCPU during qualification. Compute
    # units bypass prediction; use EstimatedCPU once the service honors it.
    exec_properties = {
        "test.EstimatedComputeUnits": "8",
        "test.EstimatedMemory": "512M",
    },
)

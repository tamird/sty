load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sty_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    compile_data = [
        ":src/builtin/bazel_tools/tools/build_defs/repo/utils.bzli",
        ":src/builtin/builtin.pb",
    ],
    crate_name = "sty",
    rustc_env_files = [":generate_rustc_env_file"],
    deps = all_crate_deps() + [
        "//crates/starpls_bazel",
        "//crates/starpls_common",
        "//crates/starpls_ide",
        "//crates/starpls_syntax",
    ],
)

rust_binary(
    name = "sty",
    srcs = ["src/main.rs"],
    deps = [":sty_lib"],
)

rust_test(
    name = "sty_test",
    crate = ":sty_lib",
)

genrule(
    name = "generate_rustc_env_file",
    srcs = [
        "Cargo.toml",
    ],
    outs = ["rustc_env_file"],
    cmd = "echo \"CARGO_PKG_VERSION=$$(grep 'version =' $(location :Cargo.toml) | awk '$$1 == \"version\" {print $$3}' | tr -d '\"')\" > $@",
)

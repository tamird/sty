# Authentication belongs in .bazelrc.local; see docs/buildbuddy.md.
build:buildbuddy-cache --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy-cache --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy-cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy-cache --remote_timeout=60s

# Linux target and execution platforms are separate from the frontend's OS.
build:buildbuddy --config=buildbuddy-cache
build:buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
build:buildbuddy --extra_execution_platforms=//bazel:remote_linux_amd64
build:buildbuddy --platforms=//bazel:linux_amd64
# The generator omits execution subpackages that duplicate HOST. Discover the
# existing packages; //bazel:linux_amd64 constrains selection to glibc 2.17.
build:buildbuddy --extra_toolchains=@zig_sdk//libc_aware/toolchain/...
build:buildbuddy --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build:buildbuddy --jobs=32
build:buildbuddy --local_resources=cpu=2
build:buildbuddy --remote_download_outputs=minimal
